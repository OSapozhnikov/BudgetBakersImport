# Application
PORT=8000
LOG_LEVEL=INFO
WEB_CONCURRENCY=1

# Default BudgetBakers account name (preselected when present in directory)
DEFAULT_ACCOUNT_NAME=Account

# Durable data (category mappings, accounts JSON)
DATA_DIR=./data

# BudgetBakers API (categories + accounts refresh)
BUDGETBAKERS_API_BASE=https://rest.budgetbakers.com/wallet/v1/api
BUDGETBAKERS_API_TOKEN=

# NBU FX: how many prior calendar days to walk back if rate missing
NBU_FX_LOOKBACK_DAYS=7
